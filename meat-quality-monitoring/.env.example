# Meat Quality Monitoring - Environment Configuration
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
#   nano .env

# ============================================================================
# Sensor API Configuration
# ============================================================================
SENSOR_API_BASE=https://your-api-host/api/meat-data
SENSOR_API_KEY=YOUR_API_KEY_HERE
SENSOR_API_TIMEOUT=10
SENSOR_API_POLL_INTERVAL=5
SENSOR_API_MAX_RETRIES=3
SENSOR_API_RETRY_BASE_DELAY=2
SENSOR_API_HISTORY_LIMIT=5000
SENSOR_API_CATCHUP_FAILURE_THRESHOLD=5

# Bookmark file location (tracks last seen reading for recovery)
BOOKMARK_FILE=~/.meat_monitor_bookmark.json

# ============================================================================
# MQTT Configuration
# ============================================================================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=YOUR_MQTT_USERNAME_HERE
MQTT_PASSWORD=YOUR_MQTT_PASSWORD_HERE

# ============================================================================
# Image Sync / Upload Configuration
# ============================================================================
UPLOAD_URL=https://your-upload-host/api/upload-image
UPLOAD_API_KEY=YOUR_UPLOAD_API_KEY_HERE
PENDING_SYNC_DIR=/home/pi/pending_sync
SYNC_DB_PATH=/home/pi/sync_state.db
SYNC_REQUEST_TIMEOUT_SECONDS=60
UPLOAD_THROTTLE_SECONDS=1.5
