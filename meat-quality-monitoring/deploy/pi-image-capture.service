[Unit]
Description=Continuous Raspberry Pi image capture
After=local-fs.target

[Service]
Type=simple
User=zihan
WorkingDirectory=/home/zihan/projects/meat-quality-monitoring
ExecStartPre=/bin/mkdir -p /home/zihan/pending_sync
ExecStart=/home/zihan/projects/meat-quality-monitoring/venv/bin/python3 /home/zihan/projects/meat-quality-monitoring/capture.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
