[Unit]
Description=Meat Quality Monitor - Streamlit Dashboard (network-accessible, port 8502)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zihan
WorkingDirectory=/home/zihan/projects/meat-quality-monitoring
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zihan/projects/meat-quality-monitoring/venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8502 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
