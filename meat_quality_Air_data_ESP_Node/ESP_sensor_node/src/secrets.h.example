#ifndef SECRETS_H
#define SECRETS_H

// ──────────────────────────────────────────────────────────────
// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored and MUST NOT be committed.
//
// If any previous API key was committed to a public repo, rotate it
// on the server BEFORE flashing the new key here.
// ──────────────────────────────────────────────────────────────

// Production sensor ingest API key (iot-session-ingest, x-api-key header)
const char* API_KEY = "YOUR_ROTATED_API_KEY_HERE";

// SoftAP captive-portal password (min 8 chars)
const char* AP_PASSWORD = "YOUR_AP_PASSWORD_HERE";

